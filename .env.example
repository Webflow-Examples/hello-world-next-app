# Canonical origin used for canonical URLs, the hreflang cluster and sitemap entries.
# Production must be the live origin. Every preview deployment must override this with its own
# origin so a canonical never points a crawler at a preview build.
NEXT_PUBLIC_SITE_URL=https://compremium.ch

# --- Pending credentials -----------------------------------------------------------------
# Webflow Data API (headless CMS). Account pending.
# WEBFLOW_SITE_ID=
# WEBFLOW_API_TOKEN=

# HubSpot Forms API. Account pending.
# HUBSPOT_PORTAL_ID=
# HUBSPOT_FORM_GUID=

# Google Tag Manager container id. Public by nature; leaving it unset loads no
# third-party script at all, which is the current state.
# NEXT_PUBLIC_GTM_ID=

# Mount path of the Webflow Cloud environment, without a trailing slash. Leave unset when the
# app is served from the origin root, which is what docs/spec/page-register.md assumes and what
# production must be.
#
# Webflow Cloud applies the mount path as Next's basePath at build time, so Link, useRouter,
# redirect and next/image are prefixed for free. This variable exists for the URLs we assemble
# ourselves - canonical, hreflang, sitemap entries, the robots host - which Next does not touch.
# An environment mounted at a subpath must set it, or it advertises canonicals that 404.
#
# Never read the mount path from next.config: Webflow Cloud generates its own config at build
# time and moves ours aside.
# NEXT_PUBLIC_BASE_PATH=/staging
